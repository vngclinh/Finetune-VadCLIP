UCF Annotation/
UCFClipFeatures/

# UCF checkpoint diagnostics dumps
ucf_checkpoint_diagnostics*/

# Top-level weight file observed in this repo
model_ucf.pth

# Generated caches / embeddings / caption dumps inside notebooks folder
code/*embeddings_cache*.json
code/*prototype_embeddings_cache*.json
code/*gpt_video_descriptions*.json
code/*gpt_video_descriptions*.csv

